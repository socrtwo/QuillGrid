<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with QuillGrid" for workbooks identified by MIME type
                 (a mimeType-only <data> matches content: and file: URIs). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.flat-spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-quillgrid" />
                <data android:mimeType="application/x-quillgrid-encrypted" />
                <!-- Legacy spreadsheets -->
                <data android:mimeType="application/vnd.lotus-1-2-3" />
                <data android:mimeType="application/x-123" />
                <data android:mimeType="application/x-quattro-pro" />
                <data android:mimeType="application/vnd.ms-works" />
                <data android:mimeType="application/x-dbf" />
                <data android:mimeType="application/dbase" />
                <data android:mimeType="application/x-dbase" />
                <data android:mimeType="application/x-sylk" />
            </intent-filter>

            <!-- Files whose provider reports a generic MIME type: match on extension.
                 Several pathPatterns per extension because Android's matcher is
                 non-greedy and stops at the first dot. Upper-case variants cover
                 names such as BUDGET.XLSX from older cameras and Windows shares. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\..*\\.xlsx" />
                <data android:pathPattern=".*\\..*\\..*\\.xlsx" />
                <data android:pathPattern=".*\\.XLSX" />
                <data android:pathPattern=".*\\..*\\.XLSX" />
                <data android:pathPattern=".*\\..*\\..*\\.XLSX" />
                <data android:pathPattern=".*\\.xlsm" />
                <data android:pathPattern=".*\\..*\\.xlsm" />
                <data android:pathPattern=".*\\..*\\..*\\.xlsm" />
                <data android:pathPattern=".*\\.xltx" />
                <data android:pathPattern=".*\\..*\\.xltx" />
                <data android:pathPattern=".*\\..*\\..*\\.xltx" />
                <data android:pathPattern=".*\\.xls" />
                <data android:pathPattern=".*\\..*\\.xls" />
                <data android:pathPattern=".*\\..*\\..*\\.xls" />
                <data android:pathPattern=".*\\.XLS" />
                <data android:pathPattern=".*\\..*\\.XLS" />
                <data android:pathPattern=".*\\..*\\..*\\.XLS" />
                <data android:pathPattern=".*\\.ods" />
                <data android:pathPattern=".*\\..*\\.ods" />
                <data android:pathPattern=".*\\..*\\..*\\.ods" />
                <data android:pathPattern=".*\\.fods" />
                <data android:pathPattern=".*\\..*\\.fods" />
                <data android:pathPattern=".*\\..*\\..*\\.fods" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\..*\\.csv" />
                <data android:pathPattern=".*\\..*\\..*\\.csv" />
                <data android:pathPattern=".*\\.CSV" />
                <data android:pathPattern=".*\\..*\\.CSV" />
                <data android:pathPattern=".*\\..*\\..*\\.CSV" />
                <data android:pathPattern=".*\\.tsv" />
                <data android:pathPattern=".*\\..*\\.tsv" />
                <data android:pathPattern=".*\\..*\\..*\\.tsv" />
                <data android:pathPattern=".*\\.qgw" />
                <data android:pathPattern=".*\\..*\\.qgw" />
                <data android:pathPattern=".*\\..*\\..*\\.qgw" />
                <data android:pathPattern=".*\\.qgwe" />
                <data android:pathPattern=".*\\..*\\.qgwe" />
                <data android:pathPattern=".*\\..*\\..*\\.qgwe" />
                <!-- rename:keep: workbooks saved by QuillLattice, the app's former name -->
                <data android:pathPattern=".*\\.qlw" />
                <data android:pathPattern=".*\\..*\\.qlw" />
                <data android:pathPattern=".*\\..*\\..*\\.qlw" />
                <data android:pathPattern=".*\\.qlwe" />
                <data android:pathPattern=".*\\..*\\.qlwe" />
                <data android:pathPattern=".*\\..*\\..*\\.qlwe" />
                            <data android:pathPattern=".*\\.wk1" />
                <data android:pathPattern=".*\\..*\\.wk1" />
                <data android:pathPattern=".*\\.WK1" />
                <data android:pathPattern=".*\\.wks" />
                <data android:pathPattern=".*\\..*\\.wks" />
                <data android:pathPattern=".*\\.WKS" />
                <data android:pathPattern=".*\\.wk3" />
                <data android:pathPattern=".*\\..*\\.wk3" />
                <data android:pathPattern=".*\\.WK3" />
                <data android:pathPattern=".*\\.wk4" />
                <data android:pathPattern=".*\\..*\\.wk4" />
                <data android:pathPattern=".*\\.WK4" />
                <data android:pathPattern=".*\\.123" />
                <data android:pathPattern=".*\\..*\\.123" />
                <data android:pathPattern=".*\\.123" />
                <data android:pathPattern=".*\\.wq1" />
                <data android:pathPattern=".*\\..*\\.wq1" />
                <data android:pathPattern=".*\\.WQ1" />
                <data android:pathPattern=".*\\.wq2" />
                <data android:pathPattern=".*\\..*\\.wq2" />
                <data android:pathPattern=".*\\.WQ2" />
                <data android:pathPattern=".*\\.wb1" />
                <data android:pathPattern=".*\\..*\\.wb1" />
                <data android:pathPattern=".*\\.WB1" />
                <data android:pathPattern=".*\\.wb2" />
                <data android:pathPattern=".*\\..*\\.wb2" />
                <data android:pathPattern=".*\\.WB2" />
                <data android:pathPattern=".*\\.wb3" />
                <data android:pathPattern=".*\\..*\\.wb3" />
                <data android:pathPattern=".*\\.WB3" />
                <data android:pathPattern=".*\\.qpw" />
                <data android:pathPattern=".*\\..*\\.qpw" />
                <data android:pathPattern=".*\\.QPW" />
                <data android:pathPattern=".*\\.xlr" />
                <data android:pathPattern=".*\\..*\\.xlr" />
                <data android:pathPattern=".*\\.XLR" />
                <data android:pathPattern=".*\\.dbf" />
                <data android:pathPattern=".*\\..*\\.dbf" />
                <data android:pathPattern=".*\\.DBF" />
                <data android:pathPattern=".*\\.slk" />
                <data android:pathPattern=".*\\..*\\.slk" />
                <data android:pathPattern=".*\\.SLK" />
                <data android:pathPattern=".*\\.dif" />
                <data android:pathPattern=".*\\..*\\.dif" />
                <data android:pathPattern=".*\\.DIF" />
            </intent-filter>

            <!-- Receive workbooks and text shared from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.flat-spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-quillgrid" />
                <data android:mimeType="application/x-quillgrid-encrypted" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- The Quill apps this one can hand documents to (Android 11+ package visibility). -->
    <queries>
        <package android:name="io.github.socrtwo.quillpen" />
        <package android:name="io.github.socrtwo.quillpost" />
        <package android:name="io.github.socrtwo.quillstage" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
